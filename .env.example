SAITAN_LLM_PROVIDER=deepseek
SAITAN_MODEL=deepseek-flash
SAITAN_API_BASE_URL=https://api.deepseek.com/v1
SAITAN_API_KEY=
SAITAN_MAX_STEPS=25
SAITAN_TIMEOUT_SECONDS=300
SAITAN_MAX_PAGES=15
SAITAN_DEFAULT_COUNT=8
SAITAN_HEADLESS=true
SAITAN_DATA_DIR=data
ANONYMIZED_TELEMETRY=false
BROWSER_USE_LOGGING_LEVEL=error
